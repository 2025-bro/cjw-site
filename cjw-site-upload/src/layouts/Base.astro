---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/layout.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteName = 'cjw-wjc-qwq 的个人网站';
const pageTitle = title ? `${title} - ${siteName}` : `${siteName} · 博客 / 代码模板 / 题目解析`;
const pageDesc =
  description ??
  '三人共同维护的免费个人网站：技术博客、算法代码模板、题目链接与个人解析，由 Cloudflare Pages 零成本托管。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href="/images/wallpapers.jpg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <script is:inline>
      // 提前套用「设置」页保存的偏好，避免刷新闪烁
      (function () {
        var html = document.documentElement;
        var DARK = ['dark', 'black', 'midnight', 'ink', 'night'];
        var p = {};
        try {
          p = JSON.parse(localStorage.getItem('prefs') || '{}') || {};
          if (!p.theme) {
            p.theme =
              localStorage.getItem('bg') ||
              localStorage.getItem('theme') ||
              (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'snow');
          }
          if (!p.accent) p.accent = localStorage.getItem('accent') || 'blue';
          if (!p.font) p.font = 'md';
          if (!p.width) p.width = 'normal';
          if (!p.bg) p.bg = p.photo === 'off' ? 'solid' : 'wallpaper';
          if (!p.wallpaper) p.wallpaper = 'sunset';
          if (typeof p.scrim !== 'number') p.scrim = 0.45;
        } catch (e) {
          p = {
            theme: 'snow',
            accent: 'blue',
            font: 'md',
            width: 'normal',
            bg: 'wallpaper',
            wallpaper: 'sunset',
            scrim: 0.45,
          };
        }
        html.setAttribute('data-theme', p.theme);
        html.setAttribute('data-accent', p.accent);
        html.setAttribute('data-font', p.font);
        html.setAttribute('data-width', p.width);
        html.setAttribute('data-bg', p.bg);
        html.setAttribute('data-wallpaper', p.wallpaper);
        html.setAttribute('data-dark', DARK.indexOf(p.theme) >= 0 ? '1' : '0');
        html.style.setProperty('--scrim-a', String(p.scrim));
      })();
    </script>
  </head>
  <body>
    <Header />
    <div class="app">
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      // 窄屏抽屉菜单
      const sidebar = document.getElementById('sidebar');
      const menuBtn = document.getElementById('menu-btn');
      const closeNav = () => sidebar?.classList.remove('open');

      menuBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        sidebar?.classList.toggle('open');
      });

      sidebar?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeNav));

      document.addEventListener('click', (e) => {
        if (!sidebar?.classList.contains('open')) return;
        const target = e.target as HTMLElement;
        if (!target.closest('.sidebar') && !target.closest('#menu-btn')) closeNav();
      });
    </script>
  </body>
</html>
