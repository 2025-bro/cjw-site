---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/layout.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteName = 'cjw-wjc-qwq 的个人网站';
const pageTitle = title ? `${title} - ${siteName}` : `${siteName} · 博客 / 代码模板 / 题目解析`;
const pageDesc =
  description ??
  '三人共同维护的免费个人网站：技术博客、算法代码模板、题目链接与个人解析，由 Cloudflare Pages 零成本托管。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <script is:inline>
      // 提前套用背景主题与配色，避免刷新闪烁
      (function () {
        var html = document.documentElement;
        try {
          var saved = localStorage.getItem('bg') || localStorage.getItem('theme');
          var theme =
            saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          html.setAttribute('data-theme', theme);
          html.setAttribute('data-accent', localStorage.getItem('accent') || 'blue');
        } catch (e) {
          html.setAttribute('data-theme', 'light');
          html.setAttribute('data-accent', 'blue');
        }
      })();
    </script>
  </head>
  <body>
    <Header />
    <div class="app">
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      // 背景主题切换：浅色 / 米黄 / 护眼绿 / 淡蓝 / 淡紫 / 深色 / 纯黑
      const themeDots = Array.from(document.querySelectorAll('.theme-dot')) as HTMLElement[];
      const accentDots = Array.from(document.querySelectorAll('.accent-dot')) as HTMLElement[];

      const markDots = (dots: HTMLElement[], attr: string) => {
        const cur = document.documentElement.getAttribute(attr);
        dots.forEach((d) => d.classList.toggle('on', d.dataset[attr === 'data-theme' ? 'theme' : 'accent'] === cur));
      };

      themeDots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const key = dot.dataset.theme ?? 'light';
          document.documentElement.setAttribute('data-theme', key);
          try {
            localStorage.setItem('bg', key);
          } catch (e) {
            /* ignore */
          }
          markDots(themeDots, 'data-theme');
        });
      });

      accentDots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const key = dot.dataset.accent ?? 'blue';
          document.documentElement.setAttribute('data-accent', key);
          try {
            localStorage.setItem('accent', key);
          } catch (e) {
            /* ignore */
          }
          markDots(accentDots, 'data-accent');
        });
      });

      markDots(themeDots, 'data-theme');
      markDots(accentDots, 'data-accent');

      // 窄屏抽屉菜单
      const sidebar = document.getElementById('sidebar');
      const menuBtn = document.getElementById('menu-btn');
      const closeNav = () => sidebar?.classList.remove('open');

      menuBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        sidebar?.classList.toggle('open');
      });

      sidebar?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeNav));

      document.addEventListener('click', (e) => {
        if (!sidebar?.classList.contains('open')) return;
        const target = e.target as HTMLElement;
        if (!target.closest('.sidebar') && !target.closest('#menu-btn')) closeNav();
      });
    </script>
  </body>
</html>
