---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/layout.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteName = 'cjw-wjc-qwq 的个人网站';
const pageTitle = title ? `${title} - ${siteName}` : `${siteName} · 博客 / 代码模板 / 题目解析`;
const pageDesc =
  description ??
  '三人共同维护的免费个人网站：技术博客、算法代码模板、题目链接与个人解析，由 Cloudflare Pages 零成本托管。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <script is:inline>
      // 提前设置主题，避免闪烁
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-accent', localStorage.getItem('accent') || 'blue');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.setAttribute('data-accent', 'blue');
        }
      })();
    </script>
  </head>
  <body>
    <Header />
    <div class="app">
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      // 主题切换：侧边栏和顶栏的两个按钮都用 class 绑定
      document.querySelectorAll('.theme-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {
            /* ignore */
          }
        });
      });

      // 配色切换：蓝紫 / 青蓝 / 青绿 / 橙红 / 品红 / 朱红 / 彩虹
      const dots = Array.from(document.querySelectorAll('.accent-dot')) as HTMLElement[];
      const markDots = () => {
        const cur = document.documentElement.getAttribute('data-accent');
        dots.forEach((d) => d.classList.toggle('on', d.dataset.accent === cur));
      };
      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const key = dot.dataset.accent ?? 'blue';
          document.documentElement.setAttribute('data-accent', key);
          try {
            localStorage.setItem('accent', key);
          } catch (e) {
            /* ignore */
          }
          markDots();
        });
      });
      markDots();

      // 窄屏抽屉菜单
      const sidebar = document.getElementById('sidebar');
      const menuBtn = document.getElementById('menu-btn');
      const closeNav = () => sidebar?.classList.remove('open');

      menuBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        sidebar?.classList.toggle('open');
      });

      sidebar?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeNav));

      document.addEventListener('click', (e) => {
        if (!sidebar?.classList.contains('open')) return;
        const target = e.target as HTMLElement;
        if (!target.closest('.sidebar') && !target.closest('#menu-btn')) closeNav();
      });
    </script>
  </body>
</html>
