---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/format';
import { TAXONOMY, FALLBACK_MAJOR } from '../../data/taxonomy';
import { MAJOR_INTRO } from '../../data/major-intro';

/**
 * 分类规则说明（分类表本身在 src/data/taxonomy.ts，要新增分类改那个文件）
 * category 三种写法：
 *   1) 小类名，例如 category: 线段树            —— 自动归到「数据结构」大类下
 *   2) 大类名，例如 category: 图论              —— 只归到大类
 *   3) 显式层级，例如 category: 图论 / 网络流    —— 同时指定大类和小类
 * 表里没有的名字不会报错，会作为新的大类出现。
 */

/** 把模板的 category 解析成「大类 + 小类」 */
function classify(raw: string): { major: string; minor: string } {
  const cat = (raw ?? '').trim();
  if (!cat) return { major: FALLBACK_MAJOR, minor: '' };

  // 显式层级写法：大类 / 小类（也兼容 > · | 分隔）
  const parts = cat
    .split(/\s*[/>·|]\s*/)
    .map((s) => s.trim())
    .filter(Boolean);
  if (parts.length >= 2) return { major: parts[0], minor: parts.slice(1).join(' · ') };

  // 命中分类表
  for (const [major, minors] of Object.entries(TAXONOMY)) {
    if (minors.includes(cat)) return { major, minor: cat };
    if (major === cat) return { major, minor: '' };
  }

  // 分类表之外的自定义名字：自己成为一个大类
  return { major: cat, minor: '' };
}

const templates = await getCollection('templates');
const items = templates.map((entry) => {
  const { major, minor } = classify(entry.data.category);
  return { entry, major, minor };
});

const MAJOR_ORDER = [...Object.keys(TAXONOMY), FALLBACK_MAJOR];
const groups = [...new Set(items.map((i) => i.major))]
  .sort((a, b) => {
    const ia = MAJOR_ORDER.indexOf(a);
    const ib = MAJOR_ORDER.indexOf(b);
    return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib) || a.localeCompare(b, 'zh-CN');
  })
  .map((major) => ({
    major,
    intro: MAJOR_INTRO[major],
    items: items
      .filter((i) => i.major === major)
      .sort(
        (a, b) =>
          (a.minor || '').localeCompare(b.minor || '', 'zh-CN') ||
          a.entry.data.title.localeCompare(b.entry.data.title, 'zh-CN'),
      ),
  }));

const minorTotal = Object.values(TAXONOMY).reduce((n, list) => n + list.length, 0);
---

<Base title="代码模板" description="参照 OI Wiki 专题结构整理的两级分类算法代码模板">
  <div class="container">
    <header class="page-head">
      <h1>🧩 代码模板</h1>
      <p>
        按 <strong>大类 → 小类</strong> 两级整理，共 {templates.length} 个模板、{groups.length} 个大类。
        分类参照 <a href="https://oi-wiki.org/" target="_blank" rel="noopener">OI Wiki</a> 的专题划分。
        新增模板时在文件开头写 <code>category: 小类名</code> 即可自动归位。
      </p>
    </header>

    <details class="taxonomy">
      <summary>
        📚 分类总览（{Object.keys(TAXONOMY).length} 个大类 · {minorTotal} 个小类，点开查看完整清单）
      </summary>
      <div class="taxonomy-grid">
        {
          Object.entries(TAXONOMY).map(([major, minors]) => (
            <div class="taxonomy-item">
              <strong>{major}</strong>
              <span>{minors.join(' · ')}</span>
            </div>
          ))
        }
      </div>
      <p class="taxonomy-tip">
        写模板时 <code>category</code> 填小类名（如 <code>线段树</code>）会自动归入对应大类；填
        <code>大类 / 小类</code>（如 <code>图论 / 网络流</code>）可显式指定层级；清单里没有的名字也能正常使用，会自动出现在分类里。
        完整分类表在 <code>src/data/taxonomy.ts</code>，要新增分类改那里；新建模板可复制 <code>src/content/templates/空白模板</code>。
      </p>
    </details>

    <div class="filters" id="major-filters">
      <button class="chip on" data-major="all">全部（{templates.length}）</button>
      {
        groups.map((g) => (
          <button class="chip" data-major={g.major}>
            {g.major}（{g.items.length}）
          </button>
        ))
      }
    </div>

    <div class="filters" id="minor-filters" style="display:none"></div>

    <div class="search-box" style="max-width:none;margin:0 0 22px">
      <span class="icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path>
        </svg>
      </span>
      <input type="text" id="tpl-search" placeholder="输入关键词快速筛选模板…" />
    </div>

    <div id="tpl-list">
      {
        groups.map((g) => (
          <section class="tpl-group" data-major={g.major}>
            <div class="section-head">
              <h2>{g.major}</h2>
              <span class="group-count">{g.items.length} 个模板</span>
            </div>
            {
              g.intro && (
                <details class="major-intro">
                  <summary>
                    <span class="mi-tag">概念共识</span>
                    {g.intro.tagline}
                  </summary>
                  <div class="mi-body">
                    {g.intro.sections.map((s) => (
                      <div class="mi-sec">
                        <h3>{s.h}</h3>
                        <ul>
                          {s.items.map((it) => (
                            <li>{it}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </details>
              )
            }
            <div class="card-list">
              {g.items.map((it) => (
                <a
                  class="card"
                  href={`/templates/${it.entry.id}/`}
                  data-major={g.major}
                  data-minor={it.minor}
                  data-key={`${it.entry.data.title} ${it.minor} ${g.major} ${it.entry.data.tags.join(' ')}`}
                >
                  <div class="meta">
                    <span class="tag purple">{it.minor || g.major}</span>
                    <span>{it.entry.data.author}</span>
                    <span>{formatDate(it.entry.data.date)}</span>
                  </div>
                  <h3>{it.entry.data.title}</h3>
                  <p>{it.entry.data.description}</p>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <div class="empty" id="empty-tip" style="display:none">没有符合条件的模板</div>
  </div>
</Base>

<style>
  .taxonomy {
    margin: 18px 0 22px;
    padding: 14px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    font-size: 14px;
  }
  .taxonomy summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
  }
  .taxonomy-grid {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 22px;
  }
  @media (max-width: 760px) {
    .taxonomy-grid {
      grid-template-columns: 1fr;
    }
  }
  .taxonomy-item strong {
    color: var(--accent);
    margin-right: 8px;
  }
  .taxonomy-item span {
    color: var(--text-2);
    font-size: 13.5px;
  }
  .taxonomy-tip {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px dashed var(--border);
    color: var(--text-2);
    font-size: 13px;
  }
  .tpl-group {
    margin-bottom: 34px;
  }

  /* 每个大类前面的「概念共识 + 基础常识」 */
  .major-intro {
    margin: 0 0 18px;
    padding: 12px 18px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--glass-strong) 92%, var(--bg));
    font-size: 13.5px;
  }
  .major-intro summary {
    cursor: pointer;
    color: var(--text-2);
    line-height: 1.7;
  }
  .major-intro summary:hover {
    color: var(--accent);
  }
  .mi-tag {
    display: inline-block;
    margin-right: 8px;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
  }
  .mi-body {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 26px;
  }
  @media (max-width: 820px) {
    .mi-body {
      grid-template-columns: 1fr;
    }
  }
  .mi-sec h3 {
    margin: 6px 0 4px;
    font-size: 13px;
    color: var(--accent);
    font-weight: 600;
  }
  .mi-sec ul {
    margin: 0;
    padding-left: 18px;
  }
  .mi-sec li {
    margin: 3px 0;
    color: var(--text-2);
    line-height: 1.65;
  }
  .group-count {
    font-size: 13px;
    color: var(--text-3);
    font-family: var(--font-mono);
  }
</style>

<script>
  const cards = Array.from(document.querySelectorAll('#tpl-list .card')) as HTMLElement[];
  const groupEls = Array.from(document.querySelectorAll('#tpl-list .tpl-group')) as HTMLElement[];
  const majorChips = Array.from(document.querySelectorAll('#major-filters .chip')) as HTMLElement[];
  const minorWrap = document.getElementById('minor-filters') as HTMLElement | null;
  const search = document.getElementById('tpl-search') as HTMLInputElement | null;
  const empty = document.getElementById('empty-tip');

  let curMajor = 'all';
  let curMinor = 'all';

  function minorsOf(major: string): string[] {
    const set = new Set<string>();
    cards.forEach((c) => {
      if (c.dataset.major === major && c.dataset.minor) set.add(c.dataset.minor);
    });
    return Array.from(set);
  }

  function renderMinorChips() {
    if (!minorWrap) return;
    minorWrap.innerHTML = '';
    if (curMajor === 'all') {
      minorWrap.style.display = 'none';
      return;
    }
    const minors = minorsOf(curMajor);
    if (!minors.length) {
      minorWrap.style.display = 'none';
      return;
    }
    minorWrap.style.display = '';
    const make = (label: string, val: string) => {
      const b = document.createElement('button');
      b.className = 'chip' + (curMinor === val ? ' on' : '');
      b.textContent = label;
      b.addEventListener('click', () => {
        curMinor = val;
        renderMinorChips();
        apply();
      });
      return b;
    };
    minorWrap.appendChild(make('全部小类', 'all'));
    minors.forEach((m) =>
      minorWrap.appendChild(
        make(
          `${m}（${cards.filter((c) => c.dataset.major === curMajor && c.dataset.minor === m).length}）`,
          m,
        ),
      ),
    );
  }

  function apply() {
    const kw = (search?.value ?? '').trim().toLowerCase();
    let shown = 0;
    cards.forEach((card) => {
      const okMajor = curMajor === 'all' || card.dataset.major === curMajor;
      const okMinor = curMinor === 'all' || card.dataset.minor === curMinor;
      const okKw = !kw || (card.dataset.key ?? '').toLowerCase().includes(kw);
      const hit = okMajor && okMinor && okKw;
      card.style.display = hit ? '' : 'none';
      if (hit) shown++;
    });
    groupEls.forEach((g) => {
      const anyVisible = Array.from(g.querySelectorAll('.card')).some(
        (c) => (c as HTMLElement).style.display !== 'none',
      );
      g.style.display = anyVisible ? '' : 'none';
    });
    if (empty) empty.style.display = shown ? 'none' : '';
  }

  majorChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      majorChips.forEach((c) => c.classList.remove('on'));
      chip.classList.add('on');
      curMajor = chip.dataset.major ?? 'all';
      curMinor = 'all';
      renderMinorChips();
      apply();
    });
  });
  search?.addEventListener('input', apply);
</script>
