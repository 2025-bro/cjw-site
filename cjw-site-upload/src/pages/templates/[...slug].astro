---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const temps = await getCollection('templates');
  return temps.map((t) => ({ params: { slug: t.id }, props: { entry: t } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Article title={entry.data.title} description={entry.data.description}>
  <div slot="meta" class="meta">
    <span class="tag purple">{entry.data.category}</span>
    <span>作者：{entry.data.author}</span>
    <span>更新于 {formatDate(entry.data.date)}</span>
    {
      entry.data.tags.map((t) => <span class="tag">{t}</span>)
    }
  </div>
  <Content />
</Article>
