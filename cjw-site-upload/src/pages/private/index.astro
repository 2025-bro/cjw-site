---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/format';

// links.md 是链接墙的数据文件，有专属页面，不算普通笔记
const notes = (await getCollection('notes'))
  .filter((n) => n.id !== 'links')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const hasLinks = (await getCollection('notes')).some((n) => n.id === 'links');
---

<Base title="内部区" description="三人内部资料，需登录查看">
  <div class="container">
    <header class="page-head">
      <h1>🔒 内部区</h1>
      <p>仅限三位维护者查看的内部资料。内容存在 <code>src/content/private/</code>，推送后自动更新。</p>
    </header>

    <div class="notice">
      ✅ 已通过验证。当前共 {notes.length} 条内部笔记。写新笔记：在
      <code>src/content/private/</code> 下新建 <code>.md</code> 文件并提交即可，格式见
      <a href="/guide/">发布指南</a>。
    </div>

    <div class="card-list" style="margin-top:20px">
      {
        hasLinks && (
          <a class="card" href="/private/links/">
            <div class="meta">
              <span class="tag accent">工具</span>
              <span>内部</span>
            </div>
            <h3>🔗 链接墙</h3>
            <p>常用链接集中放一页，全部写在一个 links.md 里 →</p>
          </a>
        )
      }
      {
        notes.map((note) => (
          <a class="card" href={`/private/${note.id}/`}>
            <div class="meta">
              <span>{formatDate(note.data.date)}</span>
              <span>{note.data.author}</span>
              <span class="tag purple">内部</span>
            </div>
            <h3>{note.data.title}</h3>
            <p>点击阅读 →</p>
          </a>
        ))
      }
    </div>

    <form method="post" action="/api/logout" style="margin-top:26px">
      <button class="btn ghost" type="submit">退出登录</button>
    </form>
  </div>
</Base>
