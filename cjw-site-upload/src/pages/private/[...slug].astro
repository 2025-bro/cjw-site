---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((n) => ({ params: { slug: n.id }, props: { entry: n } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Article title={entry.data.title} description="内部笔记（仅登录后可见）">
  <div slot="meta" class="meta">
    <span class="tag purple">🔒 内部</span>
    <span>作者：{entry.data.author}</span>
    <span>{formatDate(entry.data.date)}</span>
  </div>
  <div slot="actions" class="problem-actions">
    <a class="btn ghost" href="/private/">← 返回内部区</a>
  </div>
  <Content />
</Article>
