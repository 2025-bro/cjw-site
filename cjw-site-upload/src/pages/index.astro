---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate } from '../lib/format';

const [posts, templates, problems] = await Promise.all([
  getCollection('blog'),
  getCollection('templates'),
  getCollection('problems'),
]);

const recentPosts = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
const recentProblems = problems
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<Base>
  <div class="container">
    <section class="hero">
      <span class="badge">🌐 cjw-wjc-qwq.top · 零成本自建</span>
      <h1>欢迎来到 <span class="grad">我们的代码小站</span></h1>
      <p>
        这里记录三个人的技术博客、算法代码模板、题目链接与个人解析。
        网站公开浏览，内部资料放在密码保护的内部区，全程免费托管于 Cloudflare Pages。
      </p>
      <div class="stats">
        <span>📝 {posts.length} 篇博客</span>
        <span>🧩 {templates.length} 个代码模板</span>
        <span>🏷️ {problems.length} 道题目解析</span>
        <span>👥 三人共同维护</span>
      </div>
    </section>

    <section class="entry-grid">
      <a class="entry-card" href="/blog/">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
        </div>
        <h3>📝 博客</h3>
        <p>技术笔记、学习心得、生活杂记，用 Markdown 书写。</p>
        <span class="count">{posts.length} 篇 · 持续更新</span>
      </a>
      <a class="entry-card" href="/templates/">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline>
          </svg>
        </div>
        <h3>🧩 代码模板</h3>
        <p>常用算法与数据结构的 C++ 模板，比赛 / 作业随手可用。</p>
        <span class="count">{templates.length} 个模板 · 按类别整理</span>
      </a>
      <a class="entry-card" href="/problems/">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
          </svg>
        </div>
        <h3>🏷️ 题目解析</h3>
        <p>题目链接 + 个人思路与代码，按平台和难度筛选。</p>
        <span class="count">{problems.length} 道 · 洛谷 / CF / AtCoder 等</span>
      </a>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>最新博客</h2>
        <a class="more" href="/blog/">全部 →</a>
      </div>
      <div class="card-list">
        {
          recentPosts.map((post) => (
            <a class="card" href={`/blog/${post.id}/`}>
              <div class="meta">
                <span>{formatDate(post.data.date)}</span>
                <span>{post.data.author}</span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>最新题目解析</h2>
        <a class="more" href="/problems/">全部 →</a>
      </div>
      <div class="card-list">
        {
          recentProblems.map((p) => (
            <a class="card" href={`/problems/${p.id}/`}>
              <div class="meta">
                <span class="tag accent">{p.data.platform}</span>
                <span class="tag">{p.data.difficulty}</span>
                <span>{p.data.problemId}</span>
              </div>
              <h3>{p.data.title}</h3>
              <p>{p.data.tags.join(' · ')}</p>
            </a>
          ))
        }
      </div>
    </section>

    <div class="notice">
      🔒 三人内部资料（草稿、私密笔记、账号信息等）请前往 <a href="/private/"><strong>内部区</strong></a>，需要管理密码。
      新同学想参与维护？先看 <a href="/guide/"><strong>发布指南</strong></a>。
    </div>
  </div>
</Base>
