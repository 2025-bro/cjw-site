---
import Base from '../layouts/Base.astro';
---

<Base title="页面不存在">
  <div class="login-wrap">
    <div class="login-card">
      <div class="lock" style="font-size:26px">🕳️</div>
      <h1>404 · 页面不存在</h1>
      <p>你访问的页面可能已被移动或删除。</p>
      <a class="btn primary" href="/" style="justify-content:center">返回首页</a>
    </div>
  </div>
</Base>
