---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const probs = await getCollection('problems');
  return probs.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Article title={entry.data.title} description={`${entry.data.platform} ${entry.data.problemId} · ${entry.data.difficulty}`}>
  <div slot="meta" class="meta">
    <span class="tag accent">{entry.data.platform}</span>
    <span class="tag">{entry.data.difficulty}</span>
    <span>{entry.data.problemId}</span>
    <span>作者：{entry.data.author}</span>
    <span>{formatDate(entry.data.date)}</span>
    {
      entry.data.tags.map((t) => <span class="tag">{t}</span>)
    }
  </div>
  <div slot="actions" class="problem-actions">
    <a class="btn primary" href={entry.data.problemUrl} target="_blank" rel="noopener">
      🔗 去原题
    </a>
    <a class="btn ghost" href="/problems/">← 返回题目列表</a>
  </div>
  <Content />
</Article>
