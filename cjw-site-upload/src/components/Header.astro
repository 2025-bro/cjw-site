---
const path = Astro.url.pathname;

const navs = [
  { href: '/', label: '首页', icon: '🏠' },
  { href: '/blog/', label: '博客', icon: '📝' },
  { href: '/templates/', label: '代码模板', icon: '🧩' },
  { href: '/problems/', label: '题目解析', icon: '🏷️' },
  { href: '/search/', label: '搜索', icon: '🔍' },
  { href: '/guide/', label: '发布指南', icon: '📖' },
  { href: '/about/', label: '关于', icon: '👤' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const isPrivate = path.startsWith('/private/');

// 配色主题：与 layout.css 里的 html[data-accent='...'] 一一对应
const accents = [
  { key: 'blue', label: '蓝紫', dot: 'linear-gradient(135deg,#4f6df5,#8a5cf6)' },
  { key: 'cyan', label: '青蓝', dot: 'linear-gradient(135deg,#0ea5b7,#3b82f6)' },
  { key: 'green', label: '青绿', dot: 'linear-gradient(135deg,#12a150,#84cc16)' },
  { key: 'orange', label: '橙红', dot: 'linear-gradient(135deg,#f59e0b,#f43f5e)' },
  { key: 'pink', label: '品红', dot: 'linear-gradient(135deg,#e5399b,#8b5cf6)' },
  { key: 'red', label: '朱红', dot: 'linear-gradient(135deg,#e11d48,#f97316)' },
  { key: 'rainbow', label: '彩虹', dot: 'conic-gradient(from 0deg,#ff5f6d,#ffc371,#7ee8a2,#4facfe,#b06ab3,#ff5f6d)' },
];
---

<!-- 移动端顶栏：窄屏才显示 -->
<div class="mobile-bar">
  <a class="brand" href="/">
    <span class="logo">C</span>
    <span>cjw-wjc-qwq 的福瑞王国</span>
  </a>
  <div class="bar-actions">
    <button class="icon-btn theme-toggle" title="切换深色 / 浅色模式" aria-label="切换主题">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
    <button class="icon-btn" id="menu-btn" title="菜单" aria-label="打开菜单">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</div>

<!-- 侧边栏导航 -->
<aside class="sidebar" id="sidebar">
  <a class="brand" href="/">
    <span class="logo">C</span>
    <span class="brand-text">
      cjw-wjc-qwq
      <em>的福瑞王国</em>
    </span>
  </a>

  <nav class="side-nav" id="site-nav">
    {
      navs.map((n) => (
        <a href={n.href} class:list={[{ active: isActive(n.href) }]}>
          <span class="ico" aria-hidden="true">{n.icon}</span>
          <span>{n.label}</span>
        </a>
      ))
    }
    <a href="/private/" class:list={['nav-private', { active: isPrivate }]}>
      <span class="ico" aria-hidden="true">🔒</span>
      <span>18+</span>
    </a>
  </nav>

  <div class="side-foot">
    <div class="side-row">
      <span class="side-hint">配色</span>
      <div class="accent-picker" role="group" aria-label="配色主题">
        {
          accents.map((a) => (
            <button
              class="accent-dot"
              data-accent={a.key}
              title={a.label}
              aria-label={a.label}
              style={`--dot:${a.dot}`}
            />
          ))
        }
      </div>
    </div>

    <div class="side-row">
      <span class="side-hint">深色 / 浅色</span>
      <button class="icon-btn theme-toggle" title="切换深色 / 浅色模式" aria-label="切换主题">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </div>
</aside>
