---
const path = Astro.url.pathname;

const navs = [
  { href: '/', label: '首页', icon: '🏠' },
  { href: '/blog/', label: '博客', icon: '📝' },
  { href: '/templates/', label: '代码模板', icon: '🧩' },
  { href: '/problems/', label: '题目解析', icon: '🏷️' },
  { href: '/search/', label: '搜索', icon: '🔍' },
  { href: '/guide/', label: '发布指南', icon: '📖' },
  { href: '/about/', label: '关于', icon: '👤' },
  { href: '/settings/', label: '设置', icon: '⚙️' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const isPrivate = path.startsWith('/private/');
---

<!-- 移动端顶栏：窄屏才显示 -->
<div class="mobile-bar">
  <a class="brand" href="/">
    <span class="logo">C</span>
    <span>cjw-wjc-qwq 的福瑞王国</span>
  </a>
  <div class="bar-actions">
    <button class="icon-btn" id="menu-btn" title="菜单" aria-label="打开菜单">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</div>

<!-- 侧边栏导航 -->
<aside class="sidebar" id="sidebar">
  <a class="brand" href="/">
    <span class="logo">C</span>
    <span class="brand-text">
      cjw-wjc-qwq
      <em>的福瑞王国</em>
    </span>
  </a>

  <nav class="side-nav" id="site-nav">
    {
      navs.map((n) => (
        <a href={n.href} class:list={[{ active: isActive(n.href) }]}>
          <span class="ico" aria-hidden="true">{n.icon}</span>
          <span>{n.label}</span>
        </a>
      ))
    }
    <a href="/private/" class:list={['nav-private', { active: isPrivate }]}>
      <span class="ico" aria-hidden="true">🔒</span>
      <span>18+</span>
    </a>
  </nav>

  <div class="side-foot">
    外观、背景、配色、字号等都在
    <a href="/settings/">⚙️ 设置</a> 里调整。
  </div>
</aside>
