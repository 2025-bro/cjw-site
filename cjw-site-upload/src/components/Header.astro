---
const path = Astro.url.pathname;

const navs = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '博客' },
  { href: '/templates/', label: '代码模板' },
  { href: '/problems/', label: '题目解析' },
  { href: '/search/', label: '搜索' },
  { href: '/guide/', label: '发布指南' },
  { href: '/about/', label: '关于' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      <span class="logo">C</span>
      <span>cjw-wjc-qwq 的福瑞王国</span>
    </a>

    <nav class="nav" id="site-nav">
      {
        navs.map((n) => (
          <a href={n.href} class:list={[{ active: isActive(n.href) }]}>
            {n.label}
          </a>
        ))
      }
      <a
        href="/private/"
        class:list={['nav-private', { active: path.startsWith('/private/') }]}
      >
        🔒 18+
      </a>
    </nav>

    <div class="nav-actions">
      <button class="icon-btn" id="theme-toggle" title="切换深色 / 浅色模式" aria-label="切换主题">
        <svg id="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
          <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg id="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
      <button class="icon-btn menu-btn" id="menu-btn" title="菜单" aria-label="打开菜单">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // 根据当前主题显示太阳/月亮图标
  const updateIcon = () => {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    const sun = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');
    if (sun && moon) {
      sun.style.display = dark ? '' : 'none';
      moon.style.display = dark ? 'none' : '';
    }
  };
  updateIcon();
  document.getElementById('theme-toggle')?.addEventListener('click', updateIcon);
</script>
